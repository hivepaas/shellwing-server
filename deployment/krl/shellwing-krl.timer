[Unit]
Description=Fetch the shellwing SSH key revocation list every minute
Documentation=https://github.com/hivepaas/shellwing-server/blob/main/docs/deploying.md

[Timer]
# How often this runs is how long a revocation takes to reach this server, so it is frequent: one small request a
# minute. AccuracySec keeps systemd from bundling it with other timers and spreading it out.
OnBootSec=30s
OnUnitActiveSec=1min
AccuracySec=5s
# Spread across a fleet, so that a hundred servers do not all ask in the same second.
RandomizedDelaySec=10s

[Install]
WantedBy=timers.target
