PORT=4200

# Empty on purpose: the app then calls /api on its own origin (:4200), and the
# dev server forwards those calls to the server server - VITE_SHW_API_PROXY_TARGET,
# http://localhost:10200 by default (vite.config.ts). Same origin is what makes
# the browser send the httpOnly refresh cookie, as it does in production.
VITE_SHW_DASHBOARD_BASE_URL=
VITE_SHW_API_BASE_PATH=/api
